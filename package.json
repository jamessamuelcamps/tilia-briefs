{
  "name": "tilia-briefs",
  "private": true,
  "type": "module",
  "description": "Weekly interview-style writing briefs, delivered to Slack with a Notion draft page.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "setup:notion": "node --env-file-if-exists=.env scripts/setup-notion.mjs",
    "brief:personal": "node --env-file-if-exists=.env scripts/run.mjs personal",
    "dry:personal": "node --env-file-if-exists=.env scripts/run.mjs personal --dry-run",
    "watch": "node --env-file-if-exists=.env scripts/watch.mjs",
    "dry:watch": "node --env-file-if-exists=.env scripts/watch.mjs --dry-run",
    "test": "node --test",
    "brief:short": "node --env-file-if-exists=.env scripts/run.mjs personal-short",
    "dry:short": "node --env-file-if-exists=.env scripts/run.mjs personal-short --dry-run",
    "dry:make": "node --env-file-if-exists=.env scripts/run.mjs make --dry-run"
  }
}
