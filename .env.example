# Copy to .env for local runs. Never commit .env.

# Notion internal integration secret (notion.so/profile/integrations)
NOTION_TOKEN=
# Only needed once, for `npm run setup:notion`: the page the database is created under
NOTION_PARENT_PAGE_ID=
# Printed by `npm run setup:notion`
NOTION_DATABASE_ID=

# Slack incoming webhook URL (api.slack.com/apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=

# GitHub fine-grained token for the portfolio repo only, with Contents: read and write. Used to publish posts.
PORTFOLIO_TOKEN=

# Locally, your normal `claude` login is used. In GitHub Actions this comes from `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: override the model (default: sonnet)
# CLAUDE_MODEL=sonnet
